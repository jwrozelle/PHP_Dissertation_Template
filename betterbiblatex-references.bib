@article{rozelle_user_2026,
  title = {User Fees and Health Facility Service Readiness: A {{Bayesian}} Analysis of Data from Six Low- and Middle-Income Countries},
  shorttitle = {User Fees and Health Facility Service Readiness},
  author = {Rozelle, Jeffrey W},
  date = {2026-05-12},
  journaltitle = {International Health},
  publisher = {Oxford University Press},
  issn = {1876-3413, 1876-3405},
  doi = {10.1093/inthealth/ihag050},
  url = {https://academic.oup.com/inthealth/advance-article/doi/10.1093/inthealth/ihag050/8676273},
  urldate = {2026-05-19},
  abstract = {Abstract                            Background               User fee removal may improve affordability, but its implications for facility readiness are unclear. Evidence is limited on whether fee charging is associated with specific readiness domains, especially those dependent on recurrent operating funds.                                         Methods               This study conducted a cross-sectional secondary analysis of Service Provision Assessment facility audits from Afghanistan, Bangladesh, Ethiopia, Malawi, Nepal, and Tanzania (2013–22). Country-specific Bayesian linear mixed models estimated associations between any client fee charging and the overall Service Readiness Index (0–10) and its five domains, adjusting for rural location, other revenue sources, and service volume, with facility-type-by-managing-authority random intercepts.                                         Results               Associations with overall readiness varied by country. The largest adjusted differences were observed in Nepal (0.56, 95\% credible interval 0.43–0.69) and Malawi (0.38, 0.14–0.61), with smaller positive estimates in Bangladesh and Ethiopia, uncertainty in Afghanistan, and little evidence in Tanzania. Across settings, associations were concentrated in diagnostic capacity and essential medicines. Tanzania showed no overall association and lower infection prevention readiness among facilities charging client fees.                                         Conclusions               Charging client fees was most consistently associated with diagnostic capacity and essential medicines in stock, domains reliant on recurrent procurement. Systems offering care without user fees should ensure sustainable replenishment and monitor stocks.},
  langid = {english},
  file = {/home/jwrozelle/Zotero/storage/AKHHICNY/Rozelle - 2026 - User fees and health facility service readiness a Bayesian analysis of data from six low- and middl.pdf}
}
